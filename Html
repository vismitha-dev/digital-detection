<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Digital Detector</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<header class="navbar">
    <div class="logo">🔍 Digital Detector</div>
    <nav>
        <a href="#home">Home</a>
        <a href="#detector">Detector</a>
        <a href="#dashboard">Dashboard</a>
        <a href="#history">History</a>
    </nav>
</header>

<section class="hero" id="home">
    <div class="hero-content">
        <span class="tag">SMART LOSS DETECTION SYSTEM</span>
        <h1>Find Your Lost Digital Items</h1>
        <p>
            A smart web application that helps investigate
            lost digital devices using classroom images and videos.
        </p>
        <a href="#detector" class="primary-btn">Start Detection</a>
    </div>
    <div class="hero-icon">🔎</div>
</section>

<section class="features">
    <h2>Our Features</h2>
    <div class="feature-grid">
        <div class="feature-card">
            <span>📤</span>
            <h3>Upload Evidence</h3>
            <p>Upload classroom images or CCTV videos.</p>
        </div>
        <div class="feature-card">
            <span>🤖</span>
            <h3>Smart Analysis</h3>
            <p>Analyze evidence using computer vision.</p>
        </div>
        <div class="feature-card">
            <span>👥</span>
            <h3>Person Detection</h3>
            <p>Detect people appearing in the evidence.</p>
        </div>
        <div class="feature-card">
            <span>📊</span>
            <h3>Incident Tracking</h3>
            <p>View reports and previous detection records.</p>
        </div>
    </div>
</section>

<section class="detector section" id="detector">
    <h2>Report a Lost Item</h2>
    <p class="section-subtitle">Enter the missing device details and upload evidence.</p>

    <form id="detectForm">
        <div class="form-grid">
            <div>
                <label for="deviceType">Device Type</label>
                <select id="deviceType" name="device_type" required>
                    <option value="">Select device</option>
                    <option>Calculator</option>
                    <option>Laptop</option>
                    <option>Mobile Phone</option>
                    <option>Tablet</option>
                    <option>Other</option>
                </select>
            </div>

            <div>
                <label for="deviceName">Device Name / Model</label>
                <input id="deviceName" name="device_name"
                       type="text" placeholder="Example: Casio FX-991ES" required>
            </div>

            <div>
                <label for="location">Last Seen Location</label>
                <input id="location" name="location"
                       type="text" placeholder="Example: Classroom 204" required>
            </div>

            <div>
                <label for="incidentTime">Date and Time</label>
                <input id="incidentTime" name="incident_time"
                       type="datetime-local" required>
            </div>
        </div>

        <label for="description">Additional Information</label>
        <textarea id="description" name="description"
                  placeholder="Describe when and where the item was last seen..."></textarea>

        <label for="evidence">Upload Image or Video</label>
        <input id="evidence" name="file" type="file"
               accept="image/*,video/mp4,video/avi,video/quicktime,video/x-matroska"
               required>

        <div id="preview" class="preview"></div>

        <button type="submit" id="detectBtn" class="primary-btn">
            Start Detection
        </button>
    </form>

    <div id="message" class="message" role="status" aria-live="polite"></div>
    <div id="result" class="result hidden"></div>
</section>

<section class="dashboard section" id="dashboard">
    <h2>Dashboard</h2>
    <div class="dashboard-grid">
        <div class="stat-card">
            <h3 id="totalReports">0</h3>
            <p>Total Reports</p>
        </div>
        <div class="stat-card">
            <h3 id="totalAnalyses">0</h3>
            <p>Analyses Completed</p>
        </div>
        <div class="stat-card">
            <h3 id="totalPeople">0</h3>
            <p>People Detected</p>
        </div>
        <div class="stat-card">
            <h3 id="openCases">0</h3>
            <p>Open Cases</p>
        </div>
    </div>
</section>

<section class="history section" id="history">
    <h2>Incident History</h2>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Case ID</th>
                    <th>Device</th>
                    <th>Location</th>
                    <th>People Detected</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="historyBody">
                <tr>
                    <td colspan="5">No incident records available.</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<footer>
    <h3>Digital Detector</h3>
    <p>Smart Digital Loss Detection & Incident Monitoring System</p>
    <p>© 2026 Digital Detector | College Project</p>
</footer>

<script src="script.js"></script>
</body>
</html>
