* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #f5f8ff;
    color: #1e293b;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 7%;
    background: white;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    position: sticky;
    top: 0;
    z-index: 10;
}

.logo {
    font-size: 22px;
    font-weight: bold;
    color: #2563eb;
}

nav a {
    text-decoration: none;
    color: #334155;
    margin-left: 25px;
    font-weight: bold;
}

nav a:hover {
    color: #2563eb;
}

.hero {
    min-height: 420px;
    padding: 75px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(120deg, #dbeafe, #eff6ff);
}

.hero-content {
    max-width: 650px;
}

.tag {
    color: #2563eb;
    font-size: 13px;
    font-weight: bold;
}

.hero h1 {
    font-size: 48px;
    margin: 20px 0;
}

.hero p {
    color: #64748b;
    font-size: 17px;
    line-height: 1.7;
    margin-bottom: 30px;
}

.hero-icon {
    font-size: 130px;
}

.primary-btn {
    display: inline-block;
    border: none;
    background: #2563eb;
    color: white;
    padding: 14px 25px;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
    text-decoration: none;
}

.primary-btn:hover {
    background: #1d4ed8;
}

.features, .section {
    padding: 65px 8%;
    text-align: center;
}

h2 {
    font-size: 30px;
    margin-bottom: 30px;
}

.feature-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.feature-card, .stat-card {
    background: white;
    padding: 28px 18px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
}

.feature-card span {
    font-size: 38px;
}

.feature-card h3 {
    margin: 15px 0 10px;
}

.feature-card p, .section-subtitle {
    color: #64748b;
    line-height: 1.6;
}

.detector {
    background: white;
}

.section-subtitle {
    margin-top: -18px;
    margin-bottom: 30px;
}

form {
    max-width: 850px;
    margin: auto;
    text-align: left;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

label {
    display: block;
    margin: 18px 0 8px;
    font-weight: bold;
}

input, select, textarea {
    width: 100%;
    padding: 13px;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    font-size: 15px;
    background: white;
}

textarea {
    min-height: 100px;
    resize: vertical;
}

form .primary-btn {
    margin-top: 20px;
}

.preview {
    margin-top: 15px;
}

.preview img, .preview video {
    max-width: 100%;
    max-height: 300px;
    border-radius: 10px;
}

.message {
    margin: 20px auto;
    max-width: 850px;
    color: #b45309;
    text-align: left;
}

.result {
    max-width: 850px;
    margin: 20px auto;
    padding: 22px;
    background: #eff6ff;
    border-left: 5px solid #2563eb;
    border-radius: 8px;
    text-align: left;
    line-height: 1.8;
}

.hidden {
    display: none;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.stat-card h3 {
    font-size: 35px;
    color: #2563eb;
}

.stat-card p {
    margin-top: 10px;
    color: #64748b;
}

.table-container {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    background: white;
}

th, td {
    padding: 16px;
    border: 1px solid #e2e8f0;
    text-align: center;
}

th {
    background: #2563eb;
    color: white;
}

footer {
    padding: 35px;
    background: #172554;
    color: white;
    text-align: center;
    line-height: 2;
}

@media (max-width: 800px) {
    .navbar {
        flex-direction: column;
        gap: 18px;
    }

    nav a {
        margin: 7px;
        display: inline-block;
    }

    .hero {
        flex-direction: column;
        text-align: center;
        gap: 25px;
    }

    .hero h1 {
        font-size: 36px;
    }

    .feature-grid, .dashboard-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 500px) {
    .feature-grid, .dashboard-grid, .form-grid {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        font-size: 30px;
    }
}
